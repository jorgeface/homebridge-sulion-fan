{
  "pluginAlias": "HomebridgeSulionFan",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Sulion fan"
      },
      "devices": {
        "type": "array",
        "title": "Fans",
        "items": {
          "type": "object",
          "properties": {
              "ip": {
                "title": "IP",
                "type": "string",
                "required": true,
                "default": "IP Address of the Sulion fan"
              },
              "id": {
                "title": "ID",
                "type": "string",
                "required": true,
                "default": "Tuya Local ID"
              },
              "key": {
                "title": "Key",
                "type": "string",
                "required": true,
                "default": "Tuya Local Key"
              }
           }
        }
      }
    }
  }
}
